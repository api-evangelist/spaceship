{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spaceship.com Async Operations Contacts attributes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contacts attributes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Save contact attributes",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://spaceship.dev/api/v1/contacts/attributes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Save contact attributes and return the generated contact ID.\n\n### Required Permissions \n\n - <a href=\"#scopes/contacts:write\">contacts:write</a>\n\n### Rate Limits \n\n * The limit for saving contact attribute details is 300 requests per user, within 300 seconds."
        },
        {
          "info": {
            "name": "Read attribute details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://spaceship.dev/api/v1/contacts/attributes/:contact",
            "params": [
              {
                "name": "contact",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Read attribute details by contact ID.\n\n### Required Permissions \n\n - <a href=\"#scopes/contacts:read\">contacts:read</a>\n\n### Rate Limits \n\n * The limit for listing contact attribute details is 5 requests per attribute, within 300 seconds."
        }
      ]
    }
  ],
  "bundled": true
}